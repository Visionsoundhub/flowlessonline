---
import Layout from '../layouts/Layout.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';

const reader = createReader(process.cwd(), keystaticConfig);
const roster = await reader.collections.roster.all();
---

<Layout title="Roster">
    <div class="page-header">
        <div class="container text-center">
            <h1>Our <span class="text-accent">Roster</span></h1>
            <p>The artists that make Flowless Music.</p>
        </div>
    </div>

    <section class="roster-grid-section">
        <div class="container">
            <div class="roster-grid">
                {roster.map(async (artist) => {
                    const data = artist.entry;
                    return (
                        <div class={`artist-card ${data.featured ? 'featured' : ''}`}>
                            <div class="artist-image">
                                {data.image ? <img src={data.image} alt={artist.slug} /> : <div class="placeholder" />}
                                <div class="overlay">
                                    <div class="socials">
                                        {data.spotify && <a href={data.spotify} target="_blank" class="social-link">SP</a>}
                                        {data.instagram && <a href={data.instagram} target="_blank" class="social-link">IG</a>}
                                        {data.youtube && <a href={data.youtube} target="_blank" class="social-link">YT</a>}
                                    </div>
                                </div>
                            </div>
                            <div class="artist-info">
                                <h3>{artist.slug.replace(/-/g, ' ').toUpperCase()}</h3>
                                <div class="bio-preview">
                                    {data.bio}
                                </div>
                            </div>
                        </div>
                    );
                })}
            </div>
        </div>
    </section>
</Layout>

<style>
    .page-header {
        padding: 8rem 0 4rem;
        background-color: var(--surface-primary);
        border-bottom: 1px solid var(--surface-secondary);
    }

    .text-center {
        text-align: center;
    }

    .text-accent {
        color: var(--accent-color);
    }

    h1 {
        font-size: 4rem;
        text-transform: uppercase;
        letter-spacing: -0.02em;
    }

    .roster-grid-section {
        padding: 5rem 0;
    }

    .roster-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 3rem;
    }

    .artist-card {
        background: var(--surface-primary);
        border-radius: 16px;
        overflow: hidden;
        transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        border: 1px solid var(--surface-secondary);
    }

    .artist-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 20px 40px rgba(0,0,0,0.4);
    }

    .artist-card.featured {
        grid-column: span 2;
    }

    @media (max-width: 768px) {
        .artist-card.featured {
            grid-column: span 1;
        }
    }

    .artist-image {
        position: relative;
        height: 400px;
        overflow: hidden;
    }

    .artist-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.7s ease;
    }

    .artist-card:hover .artist-image img {
        transform: scale(1.05);
    }

    .overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, rgba(0,0,0,0.9), transparent);
        opacity: 0;
        transition: opacity 0.4s ease;
        display: flex;
        align-items: flex-end;
        justify-content: center;
        padding: 2rem;
    }

    .artist-card:hover .overlay {
        opacity: 1;
    }

    .socials {
        display: flex;
        gap: 1rem;
    }

    .social-link {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: var(--accent-color);
        color: #000;
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        font-weight: bold;
        transition: transform 0.2s ease;
    }

    .social-link:hover {
        transform: scale(1.1);
    }

    .artist-info {
        padding: 2rem;
    }

    .artist-info h3 {
        font-size: 1.8rem;
        margin-bottom: 0.5rem;
    }

    .bio-preview {
        color: var(--text-secondary);
        font-size: 0.95rem;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>
