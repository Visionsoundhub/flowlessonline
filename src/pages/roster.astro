---
import Layout from '../layouts/Layout.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';

const reader = createReader(process.cwd(), keystaticConfig);
const roster = await reader.collections.roster.all();
---

<Layout title="Roster">
    <div class="page-header">
        <div class="container text-center">
            <h1>Our <span class="text-accent">Roster</span></h1>
            <p>The artists that make Flowless Music.</p>
        </div>
    </div>

    <section class="roster-grid-section">
        <div class="container">
            <div class="roster-grid">
                {roster.map(async (artist) => {
                    const data = artist.entry;
                    const bioLines = data.bio ? data.bio.split('\n').filter((l: string) => l.trim()) : [];
                    return (
                        <div class={`artist-card ${data.featured ? 'featured' : ''}`}>
                            <div class="artist-image">
                                {data.image ? <img src={data.image} alt={data.name} /> : <div class="placeholder" />}
                                <div class="overlay">
                                    <div class="socials">
                                        {data.spotify && <a href={data.spotify} target="_blank" class="social-link" title="Spotify">
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/></svg>
                                        </a>}
                                        {(data as any).appleMusic && <a href={(data as any).appleMusic} target="_blank" class="social-link" title="Apple Music">
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M23.994 6.124a9.23 9.23 0 00-.24-2.19c-.317-1.31-1.062-2.31-2.18-3.043A5.022 5.022 0 0019.7.198C18.937.064 18.17.012 17.404.003 16.87 0 16.336 0 15.803 0H8.196C7.663 0 7.13 0 6.596.004c-.765.009-1.532.06-2.295.195-.764.135-1.483.39-2.075.794-1.117.733-1.863 1.734-2.18 3.043a9.233 9.233 0 00-.24 2.19C0 6.693 0 7.263 0 7.833v8.334c0 .57 0 1.14.006 1.709a9.232 9.232 0 00.24 2.19c.317 1.31 1.062 2.31 2.18 3.043.592.404 1.311.659 2.075.794.763.135 1.53.187 2.295.196.534.003 1.067.003 1.6.003h7.607c.533 0 1.067 0 1.6-.003.766-.009 1.533-.06 2.296-.196.763-.135 1.482-.39 2.074-.794 1.118-.733 1.863-1.734 2.18-3.043.147-.718.22-1.45.24-2.19.006-.57.006-1.14.006-1.71V7.834c0-.57 0-1.14-.006-1.71zM17.5 17.473c0 .202-.044.403-.138.59-.186.37-.52.63-.91.71-.358.074-.71-.01-.99-.23l-.005-.003c-.003-.003-.007-.005-.01-.008V9.792l-.003-.075a.315.315 0 00-.092-.189.3.3 0 00-.2-.082.452.452 0 00-.058.005l-6.57 1.353a.318.318 0 00-.25.31v7.006c0 .19-.04.38-.126.558-.185.384-.537.654-.94.73-.15.028-.302.048-.454.054-.21.01-.42.01-.63-.01a2.69 2.69 0 01-.82-.207c-.66-.3-1.072-.84-1.108-1.49a1.785 1.785 0 011.03-1.734 3.072 3.072 0 011.086-.316c.2-.017.4-.017.6-.004.166.01.332.04.49.087V9.43a1.51 1.51 0 011.18-1.47l6.06-1.374c.34-.077.685-.077 1.018.025.514.157.89.577.974 1.115.022.132.032.267.032.402l-.001 9.345h.003z"/></svg>
                                        </a>}
                                        {data.instagram && <a href={data.instagram} target="_blank" class="social-link" title="Instagram">
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
                                        </a>}
                                        {data.youtube && <a href={data.youtube} target="_blank" class="social-link" title="YouTube">
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
                                        </a>}
                                        {data.tiktok && <a href={data.tiktok} target="_blank" class="social-link" title="TikTok">
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>
                                        </a>}
                                        {(data as any).website && <a href={(data as any).website} target="_blank" class="social-link" title="Website">
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                                        </a>}
                                    </div>
                                </div>
                            </div>
                            <div class="artist-info">
                                <h3>{data.name}</h3>
                                <div class="bio-text">
                                    {bioLines.map((line: string) => <p>{line}</p>)}
                                </div>
                            </div>
                        </div>
                    );
                })}
            </div>
        </div>
    </section>
</Layout>

<style>
    .page-header {
        padding: 8rem 0 4rem;
        background-color: var(--surface-primary);
        border-bottom: 1px solid var(--surface-secondary);
    }

    .text-center {
        text-align: center;
    }

    .text-accent {
        color: var(--accent-color);
    }

    h1 {
        font-size: 4rem;
        text-transform: uppercase;
        letter-spacing: -0.02em;
    }

    .roster-grid-section {
        padding: 5rem 0;
    }

    .roster-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 3rem;
    }

    .artist-card {
        background: var(--surface-primary);
        border-radius: 16px;
        overflow: hidden;
        transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        border: 1px solid var(--surface-secondary);
    }

    .artist-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 20px 40px rgba(0,0,0,0.4);
    }

    .artist-card.featured {
        grid-column: span 2;
    }

    @media (max-width: 768px) {
        .artist-card.featured {
            grid-column: span 1;
        }
    }

    .artist-image {
        position: relative;
        height: 400px;
        overflow: hidden;
    }

    .artist-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.7s ease;
    }

    .artist-card:hover .artist-image img {
        transform: scale(1.05);
    }

    .overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, rgba(0,0,0,0.9), transparent 60%);
        opacity: 0;
        transition: opacity 0.4s ease;
        display: flex;
        align-items: flex-end;
        justify-content: center;
        padding: 2rem;
    }

    .artist-card:hover .overlay {
        opacity: 1;
    }

    .socials {
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
        justify-content: center;
    }

    .social-link {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: var(--accent-color);
        color: #000;
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        font-weight: bold;
        transition: all 0.25s ease;
    }

    .social-link:hover {
        transform: scale(1.15);
        background: #fff;
        box-shadow: 0 4px 15px rgba(255,255,255,0.3);
    }

    .artist-info {
        padding: 2rem;
    }

    .artist-info h3 {
        font-size: 1.8rem;
        margin-bottom: 1rem;
    }

    .bio-text p {
        color: var(--text-secondary);
        font-size: 0.95rem;
        line-height: 1.6;
        margin-bottom: 0.8rem;
    }

    .bio-text p:last-child {
        margin-bottom: 0;
    }
</style>
