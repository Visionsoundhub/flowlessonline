---
import Layout from '../layouts/Layout.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';

const reader = createReader(process.cwd(), keystaticConfig);
const home = await reader.singletons.home.read();

// Fetch Roster for the feed
const rosterList = await reader.collections.roster.all();
const featuredArtists = rosterList.slice(0, 3); // Take top 3 for homepage

// Default values if no config is set yet
const heroTitle = home?.heroTitle || 'Flowless Music';
const heroBg = home?.heroImage ? `url(${home.heroImage})` : 'none';
const showRelease = home?.showRelease ?? false;

// Function to convert Spotify URL to Embed URL
const getSpotifyEmbedUrl = (url: string) => {
    if (!url) return '';
    // Replace standard URL path with embed path
    let embedUrl = url.replace('open.spotify.com/', 'open.spotify.com/embed/');
    // Clean up query params if needed or add generator tracking
    if (embedUrl.includes('?')) {
        embedUrl = embedUrl.split('?')[0] + '?utm_source=generator&theme=0';
    } else {
        embedUrl += '?utm_source=generator&theme=0';
    }
    return embedUrl;
};

// Function to convert YouTube URL to Embed URL
const getYoutubeEmbedUrl = (url: string) => {
    if (!url) return '';
    let videoId = '';
    if (url.includes('youtube.com/watch')) {
        try {
            const urlObj = new URL(url);
            videoId = urlObj.searchParams.get('v') || '';
        } catch (e) {
            // fallback
            const match = url.match(/[?&]v=([^&#]+)/);
            videoId = match ? match[1] : '';
        }
    } else if (url.includes('youtu.be/')) {
        videoId = url.split('youtu.be/')[1]?.split('?')[0] || '';
    } else if (url.includes('youtube.com/embed/')) {
        videoId = url.split('youtube.com/embed/')[1]?.split('?')[0] || '';
    }
    return videoId ? `https://www.youtube.com/embed/${videoId}` : '';
};

const youtubeEmbedUrl = getYoutubeEmbedUrl(home?.releaseYoutubeUrl || '');
const spotifyEmbedUrl = getSpotifyEmbedUrl(home?.releaseSpotifyUrl || home?.releaseLinkUrl || '');
---

<Layout title="Home">
    <!-- HERO SECTION WITH SPOTLIGHT -->
    <section class="hero-spotlight" style={`background-image: radial-gradient(circle at 50% 20%, rgba(0, 255, 209, 0.08), transparent 50%), linear-gradient(rgba(8, 8, 9, 0.7), #080809), ${heroBg}`}>
        <div class="container">
            {showRelease ? (
                <div class={`spotlight-wrapper ${youtubeEmbedUrl ? 'has-video' : ''} animate-fade-up`}>
                    <div class={`spotlight-artwork-container ${youtubeEmbedUrl ? 'has-video' : ''}`}>
                        {youtubeEmbedUrl ? (
                            <iframe 
                                style="border: 0; width: 100%; height: 100%; aspect-ratio: 16/9; border-radius: 12px;" 
                                src={youtubeEmbedUrl} 
                                title="YouTube video player" 
                                frameborder="0" 
                                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
                                allowfullscreen>
                            </iframe>
                        ) : spotifyEmbedUrl ? (
                            <iframe 
                                style="border-radius:12px" 
                                src={spotifyEmbedUrl} 
                                width="100%" 
                                height="480" 
                                frameBorder="0" 
                                allowfullscreen="" 
                                allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" 
                                loading="lazy">
                            </iframe>
                        ) : (
                            home?.releaseCover && (
                                <img src={home.releaseCover} alt="Cover" class="spotlight-cover" />
                            )
                        )}
                    </div>
                    
                    <div class="spotlight-details">
                        <span class="spotlight-badge accent-glow-text">LATEST RELEASE</span>
                        <h1>{home?.releaseSong}</h1>
                        <span class="spotlight-artist">{home?.releaseTitle}</span>
                        <p class="spotlight-desc">{home?.releaseDesc}</p>
                        
                        <div class="spotlight-actions">
                            {home?.releaseYoutubeUrl && (
                                <a href={home.releaseYoutubeUrl} target="_blank" class="btn btn-youtube">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" style="margin-right: 8px;"><path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
                                    WATCH VIDEO
                                </a>
                            )}
                            {(home?.releaseSpotifyUrl || home?.releaseLinkUrl) && (
                                <a href={home.releaseSpotifyUrl || home.releaseLinkUrl} target="_blank" class="btn btn-spotify">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" style="margin-right: 8px;"><path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/></svg>
                                    LISTEN ON SPOTIFY
                                </a>
                            )}
                            {(home as any)?.releaseAppleMusicUrl && (
                                <a href={(home as any).releaseAppleMusicUrl} target="_blank" class="btn btn-apple-music">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" style="margin-right: 8px;"><path d="M23.994 6.124a9.23 9.23 0 00-.24-2.19c-.317-1.31-1.062-2.31-2.18-3.043.592-.404 1.311-.659 2.075-.794.763-.135 1.53-.187 2.295-.196.534-.003 1.067-.003 1.6-.003h7.607c.533 0 1.067 0 1.6-.003.766-.009 1.533-.06 2.296-.196.763-.135 1.482-.39 2.074-.794 1.118-.733 1.863-1.734 2.18-3.043.147-.718.22-1.45.24-2.19.006-.57.006-1.14.006-1.71V7.834c0-.57 0-1.14-.006-1.71zM17.5 17.473c0 .202-.044.403-.138.59-.186.37-.52.63-.91.71-.358.074-.71-.01-.99-.23l-.005-.003c-.003-.003-.007-.005-.01-.008V9.792l-.003-.075a.315.315 0 00-.092-.189.3.3 0 00-.2-.082.452.452 0 00-.058.005l-6.57 1.353a.318.318 0 00-.25.31v7.006c0 .19-.04.38-.126.558-.185.384-.537.654-.94.73-.15.028-.302.048-.454.054-.21.01-.42.01-.63-.01a2.69 2.69 0 01-.82-.207c-.66-.3-1.072-.84-1.108-1.49a1.785 1.785 0 011.03-1.734 3.072 3.072 0 011.086-.316c.2-.017.4-.017.6-.004.166.01.332.04.49.087V9.43a1.51 1.51 0 011.18-1.47l6.06-1.374c.34-.077.685-.077 1.018.025.514.157.89.577.974 1.115.022.132.032.267.032.402l-.001 9.345h.003z"/></svg>
                                    LISTEN ON APPLE MUSIC
                                </a>
                            )}
                        </div>
                    </div>
                </div>
            ) : (
                <div class="hero-center animate-fade-up">
                    <h1 class="premium-glitch">{heroTitle}</h1>
                    <p class="hero-subtitle">FUTURE SOUNDS & UNDERGROUND MUSIC LABEL</p>
                    <a href="/roster" class="btn">DISCOVER ROSTER</a>
                </div>
            )}
        </div>
    </section>

    <!-- CONTENT GRID (DEFECTED LOGIC) -->
    <section class="grid-section">
        <div class="container">
            <h2 class="section-title animate-fade-up">LATEST FROM THE LABEL</h2>
            
            <div class="content-grid animate-fade-up">
                <!-- GRID CARD 1: LATEST RELEASES -->
                <div class="premium-card grid-card">
                    <span class="card-tag">RELEASES</span>
                    <h3>Current Sounds</h3>
                    <p>Ακούστε τις τελευταίες επίσημες κυκλοφορίες των καλλιτεχνών μας σε όλες τις πλατφόρμες.</p>
                    
                    <div class="mini-release-list">
                        <a href={home?.releaseLinkUrl} target="_blank" class="mini-release-item-link" style="text-decoration:none; color:inherit;">
                            <div class="mini-release-item">
                                <img src={home?.releaseCover} alt="Artwork" />
                                <div class="mini-info">
                                    <span class="mini-title">{home?.releaseSong}</span>
                                    <span class="mini-artist">{home?.releaseTitle}</span>
                                </div>
                                <div class="mini-play-btn" aria-label="Open in Spotify">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
                                </div>
                            </div>
                        </a>
                    </div>
                    
                    <a href={home?.releasesPlaylistUrl || home?.releaseLinkUrl} target="_blank" class="card-link">View all Releases &rarr;</a>
                </div>

                <!-- GRID CARD 2: SOUNDCHECK -->
                <div class="premium-card grid-card highlight-card">
                    <span class="card-tag">SOUNDCHECK</span>
                    <h3>Radio & Podcasts</h3>
                    <p>Live DJ sets, podcasts και ραδιοφωνικές εκπομπές από το team του Flowless.</p>
                    <div class="soundcheck-preview">
                        <div class="wave-visualizer static-wave">
                            <div class="wave-bar playing" style="height: 14px"></div>
                            <div class="wave-bar playing" style="height: 18px"></div>
                            <div class="wave-bar playing" style="height: 12px"></div>
                            <div class="wave-bar playing" style="height: 16px"></div>
                        </div>
                    </div>
                    <a href="/soundcheck" class="btn btn-outline" style="margin-top: 1rem; width: 100%;">TUNE IN</a>
                </div>

                <!-- GRID CARD 3: MERCH -->
                <div class="premium-card grid-card">
                    <span class="card-tag">CLOTHING</span>
                    <h3>Official Merch</h3>
                    <p>Premium t-shirts, hoodies και αξεσουάρ. Σχεδιασμένα για την κοινότητά μας.</p>
                    <div style="height: 40px;"></div>
                    <a href="/merch" class="card-link">Enter the Store &rarr;</a>
                </div>
            </div>
        </div>
    </section>

    <!-- BIO / ABOUT SECTION -->
    {home?.aboutText && (
        <section class="about-section">
            <div class="container">
                <div class="about-wrapper">
                    <div class="about-image-container animate-fade-up">
                        {home.aboutImage && (
                            <img src={home.aboutImage} alt="About Flowless" class="about-img" />
                        )}
                        <div class="image-gradient-overlay"></div>
                    </div>
                    <div class="about-text-details animate-fade-up">
                        <span class="about-tag uppercase">ABOUT THE LABEL</span>
                        <h2>{home.aboutTitle}</h2>
                        <div class="about-body">
                            {home.aboutText}
                        </div>
                        {home.aboutTagline && (
                            <p class="about-tagline">
                                "{home.aboutTagline}"
                            </p>
                        )}
                    </div>
                </div>
            </div>
        </section>
    )}
</Layout>

<style>
    /* HERO SPOTLIGHT */
    .hero-spotlight {
        min-height: auto;
        padding-top: calc(var(--header-height) + 3rem);
        padding-bottom: 4rem;
        display: flex;
        align-items: center;
        background-size: cover;
        background-position: center;
        margin-top: calc(var(--header-height) * -1);
        position: relative;
        overflow: hidden;
    }

    .hero-spotlight::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 150px;
        background: linear-gradient(to top, #080809, transparent);
        z-index: 1;
        pointer-events: none;
    }

    .spotlight-wrapper {
        display: grid;
        grid-template-columns: 1fr;
        gap: 3rem;
        align-items: center;
        max-width: 1000px;
        margin: 0 auto;
        z-index: 2;
        position: relative;
    }

    @media (min-width: 768px) {
        .spotlight-wrapper {
            grid-template-columns: 350px 1fr;
        }
        .spotlight-wrapper.has-video {
            grid-template-columns: 520px 1fr;
            max-width: 1100px;
        }
    }

    .spotlight-artwork-container {
        position: relative;
        width: 100%;
        aspect-ratio: 1;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 30px 60px rgba(0,0,0,0.8), 0 0 40px rgba(0, 255, 209, 0.08);
    }

    .spotlight-artwork-container.has-video {
        aspect-ratio: 16/9;
        height: auto;
    }

    .spotlight-cover {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.6s cubic-bezier(0.25, 0.8, 0.25, 1);
    }

    .spotlight-artwork-container:hover .spotlight-cover {
        transform: scale(1.06);
    }

    .spotlight-play-btn {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%) scale(0.9);
        background: var(--accent-color);
        color: #000;
        border: none;
        width: 70px;
        height: 70px;
        border-radius: 50%;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        transition: all 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
        box-shadow: 0 10px 25px rgba(0, 255, 209, 0.4);
    }

    .spotlight-artwork-container:hover .spotlight-play-btn {
        opacity: 1;
        transform: translate(-50%, -50%) scale(1);
    }

    .spotlight-play-btn:hover {
        background: #fff;
        transform: translate(-50%, -50%) scale(1.08);
    }

    .spotlight-details h1 {
        margin: 0.5rem 0 1rem 0;
    }

    .spotlight-badge {
        font-weight: 800;
        font-size: 0.8rem;
        color: var(--accent-color);
        letter-spacing: 0.15em;
    }

    .spotlight-artist {
        font-size: 1.8rem;
        font-weight: 700;
        color: #fff;
        display: block;
        margin-bottom: 1.5rem;
    }

    .spotlight-desc {
        max-width: 600px;
        margin-bottom: 2rem;
    }

    .spotlight-actions {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
    }

    /* Hero Center (When no spotlight) */
    .hero-center {
        text-align: center;
        max-width: 800px;
        margin: 0 auto;
    }

    .premium-glitch {
        font-size: clamp(3rem, 7vw, 6rem);
        font-weight: 800;
        text-transform: uppercase;
        color: #fff;
        letter-spacing: -0.04em;
        line-height: 1;
        margin-bottom: 1rem;
    }

    .hero-subtitle {
        font-size: 1rem;
        letter-spacing: 0.2em;
        color: var(--accent-color);
        font-weight: 700;
        margin-bottom: 2.5rem;
    }

    /* GRID SECTION */
    .grid-section {
        padding: 3rem 0 6rem;
        background: #080809;
        position: relative;
    }

    .section-title {
        text-align: center;
        margin-bottom: 4rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .content-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 2rem;
    }

    @media (min-width: 768px) {
        .content-grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    .grid-card {
        display: flex;
        flex-direction: column;
        height: 100%;
        min-height: 320px;
    }

    .card-tag {
        font-size: 0.75rem;
        font-weight: 800;
        color: var(--accent-color);
        letter-spacing: 0.1em;
        margin-bottom: 1rem;
        display: block;
        text-transform: uppercase;
    }

    .grid-card h3 {
        font-size: 1.5rem;
        font-weight: 700;
        margin-bottom: 1rem;
    }

    .grid-card p {
        font-size: 1rem;
        margin-bottom: 2rem;
        flex-grow: 1;
    }

    .card-link {
        color: #fff;
        text-decoration: none;
        font-weight: 700;
        font-size: 0.95rem;
        display: inline-block;
        transition: color 0.2s ease, transform 0.2s ease;
        margin-top: auto;
    }

    .card-link:hover {
        color: var(--accent-color);
        transform: translateX(4px);
    }

    .highlight-card {
        border-color: rgba(0, 255, 209, 0.15);
        box-shadow: 0 0 40px rgba(0, 255, 209, 0.03);
    }

    /* Mini release track list inside card */
    .mini-release-list {
        margin-bottom: 2rem;
    }

    .mini-release-item {
        display: flex;
        align-items: center;
        gap: 12px;
        background: rgba(255,255,255,0.02);
        padding: 10px;
        border-radius: 8px;
        border: 1px solid rgba(255,255,255,0.03);
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .mini-release-item:hover {
        background: rgba(255,255,255,0.05);
        border-color: rgba(0, 255, 209, 0.2);
    }

    .mini-release-item img {
        width: 40px;
        height: 40px;
        border-radius: 4px;
        object-fit: cover;
    }

    .mini-info {
        display: flex;
        flex-direction: column;
        flex-grow: 1;
        overflow: hidden;
    }

    .mini-title {
        font-size: 0.85rem;
        font-weight: 700;
        white-space: nowrap;
        text-overflow: ellipsis;
        overflow: hidden;
    }

    .mini-artist {
        font-size: 0.75rem;
        color: var(--text-secondary);
    }

    .mini-play-btn {
        background: rgba(255, 255, 255, 0.05);
        border: none;
        color: #fff;
        width: 26px;
        height: 26px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .mini-release-item:hover .mini-play-btn {
        background: var(--accent-color);
        color: #000;
    }

    .soundcheck-preview {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 80px;
        background: rgba(0, 255, 209, 0.02);
        border-radius: 8px;
        border: 1px dashed rgba(0, 255, 209, 0.2);
    }

    .static-wave {
        gap: 6px;
    }

    /* ABOUT / BIO SECTION */
    .about-section {
        padding: 8rem 0;
        background: #0b0b0d;
        border-top: 1px solid rgba(255, 255, 255, 0.03);
    }

    .about-wrapper {
        display: grid;
        grid-template-columns: 1fr;
        gap: 4rem;
        align-items: center;
    }

    @media (min-width: 768px) {
        .about-wrapper {
            grid-template-columns: 1fr 1fr;
        }
    }

    .about-image-container {
        position: relative;
        border-radius: 16px;
        overflow: hidden;
        aspect-ratio: 16/10;
        box-shadow: 0 20px 40px rgba(0,0,0,0.5);
    }

    .about-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: grayscale(10%) contrast(1.1);
        transition: transform 0.5s ease;
    }

    .about-image-container:hover .about-img {
        transform: scale(1.02);
    }

    .image-gradient-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(to right, rgba(11, 11, 13, 0.4), transparent);
        pointer-events: none;
    }

    .about-tag {
        font-size: 0.8rem;
        font-weight: 800;
        color: var(--accent-color);
        letter-spacing: 0.15em;
        margin-bottom: 0.5rem;
        display: block;
    }

    .about-text-details h2 {
        margin-bottom: 1.5rem;
    }

    .about-body {
        font-size: 1.1rem;
        color: var(--text-secondary);
        margin-bottom: 2rem;
    }

    .about-tagline {
        font-size: 1.3rem;
        font-style: italic;
        color: #fff;
        border-left: 3px solid var(--accent-color);
        padding-left: 1.2rem;
        line-height: 1.4;
    }

    /* Streaming Buttons colors & shadows */
    .btn-youtube {
        background-color: transparent;
        color: #fff;
        border-color: #ff0000;
        box-shadow: 0 4px 15px rgba(255, 0, 0, 0.15);
    }
    .btn-youtube:hover {
        background-color: #ff0000;
        color: #fff;
        border-color: #ff0000;
        box-shadow: 0 8px 25px rgba(255, 0, 0, 0.35);
    }
    .btn-spotify {
        background-color: transparent;
        color: #fff;
        border-color: #1DB954;
        box-shadow: 0 4px 15px rgba(29, 185, 84, 0.15);
    }
    .btn-spotify:hover {
        background-color: #1DB954;
        color: #fff;
        border-color: #1DB954;
        box-shadow: 0 8px 25px rgba(29, 185, 84, 0.35);
    }
    .btn-apple-music {
        background-color: transparent;
        color: #fff;
        border-color: #fc3c44;
        box-shadow: 0 4px 15px rgba(252, 60, 68, 0.15);
    }
    .btn-apple-music:hover {
        background-color: #fc3c44;
        color: #fff;
        border-color: #fc3c44;
        box-shadow: 0 8px 25px rgba(252, 60, 68, 0.35);
    }
</style>

