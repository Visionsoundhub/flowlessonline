---
import '../styles/global.css';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';

interface Props {
	title: string;
}

const { title } = Astro.props;

// Fetch appearance settings (if they exist)
const reader = createReader(process.cwd(), keystaticConfig);
const appearance = await reader.singletons.appearance.read();
const accentColor = appearance?.accent || '#00FFD1';
---

<!doctype html>
<html lang="el">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Flowless Music - Official Website" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | Flowless Music</title>
        <style define:vars={{ accentColor }}>
            :root {
                --accent-color: var(--accentColor);
            }
        </style>
	</head>
	<body>
        <header>
            <div class="container">
                <a href="/" class="logo">Flowless</a>
                <nav class="desktop-nav">
                    <ul>
                        <li><a href="/">Home</a></li>
                        <li><a href="/roster">Roster</a></li>
                        <li><a href="/soundcheck">Soundcheck</a></li>
                        <li><a href="/merch">Merch</a></li>
                    </ul>
                </nav>
            </div>
        </header>
		<main>
			<slot />
		</main>
        
        <footer style="text-align: center; padding: 4rem 0; border-top: 1px solid rgba(255, 255, 255, 0.05); margin-top: 5rem; background: #080809; position: relative; z-index: 10;">
            <div class="container">
                <p style="margin-bottom: 0.5rem;">&copy; {new Date().getFullYear()} Flowless Music. All rights reserved.</p>
                <p style="font-size: 0.85rem; color: #555;">Curated beats, soundscapes and music releases.</p>
            </div>
        </footer>

        <!-- Global Persistent Sticky Audio Player -->
        <div id="global-player" class="sticky-audio-player hidden">
            <div class="player-container">
                <!-- Track details -->
                <div class="track-info">
                    <img id="player-artwork" src="/assets/fmlogo.png" alt="Artwork" />
                    <div class="track-details">
                        <span id="player-title" class="player-title">No track loaded</span>
                        <span id="player-artist" class="player-artist">Choose a release</span>
                    </div>
                </div>

                <!-- Central controls -->
                <div class="player-controls">
                    <button class="player-btn" id="prev-btn" aria-label="Previous">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="19 20 9 12 19 4 19 20"></polygon><line x1="5" y1="19" x2="5" y2="5"></line></svg>
                    </button>
                    
                    <button class="player-btn player-play-btn" id="play-btn" aria-label="Play/Pause">
                        <svg id="play-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
                        <svg id="pause-icon" class="hidden" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="4" width="4" height="16"></rect><rect x="14" y="4" width="4" height="16"></rect></svg>
                    </button>

                    <button class="player-btn" id="next-btn" aria-label="Next">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 4 15 12 5 20 5 4"></polygon><line x1="19" y1="5" x2="19" y2="19"></line></svg>
                    </button>

                    <div class="player-progress-section">
                        <span class="time-display" id="current-time">0:00</span>
                        <div class="progress-bar" id="progress-bar-container">
                            <div class="progress-filled" id="progress-filled-bar"></div>
                        </div>
                        <span class="time-display" id="total-time">0:00</span>
                    </div>
                </div>

                <!-- Volume and wave indicator -->
                <div class="player-volume-section">
                    <div class="wave-visualizer" id="wave-visualizer">
                        <div class="wave-bar"></div>
                        <div class="wave-bar"></div>
                        <div class="wave-bar"></div>
                        <div class="wave-bar"></div>
                    </div>
                    <button class="player-btn" id="mute-btn" aria-label="Volume">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path></svg>
                    </button>
                    <div class="volume-slider" id="volume-slider-container">
                        <div class="volume-filled" id="volume-filled-bar"></div>
                    </div>
                </div>
            </div>
        </div>

        <audio id="audio-element"></audio>

        <script>
            // AUDIO PLAYER LOGIC
            const audio = document.getElementById('audio-element') as HTMLAudioElement;
            const globalPlayer = document.getElementById('global-player');
            const playBtn = document.getElementById('play-btn');
            const playIcon = document.getElementById('play-icon');
            const pauseIcon = document.getElementById('pause-icon');
            const progressContainer = document.getElementById('progress-bar-container');
            const progressFilled = document.getElementById('progress-filled-bar');
            const currentTimeEl = document.getElementById('current-time');
            const totalTimeEl = document.getElementById('total-time');
            const volumeContainer = document.getElementById('volume-slider-container');
            const volumeFilled = document.getElementById('volume-filled-bar');
            const muteBtn = document.getElementById('mute-btn');
            const pArtwork = document.getElementById('player-artwork') as HTMLImageElement;
            const pTitle = document.getElementById('player-title');
            const pArtist = document.getElementById('player-artist');
            const waveBars = document.querySelectorAll('.wave-bar');

            let isPlaying = false;
            let currentQueue: any[] = [];
            let currentIndex = -1;

            // Handle Global Play Event
            window.addEventListener('play-track', (e: any) => {
                const { src, title, artist, artwork, queue, index } = e.detail;
                
                if (queue) {
                    currentQueue = queue;
                    currentIndex = index !== undefined ? index : -1;
                }

                if (audio.src !== src) {
                    audio.src = src;
                    pArtwork.src = artwork || '/assets/fmlogo.png';
                    pTitle.textContent = title;
                    pArtist.textContent = artist;
                }

                globalPlayer.classList.remove('hidden');
                togglePlay(true);
            });

            function togglePlay(forcePlay?: boolean) {
                const play = forcePlay !== undefined ? forcePlay : audio.paused;
                if (play) {
                    audio.play().then(() => {
                        playIcon.classList.add('hidden');
                        pauseIcon.classList.remove('hidden');
                        waveBars.forEach(bar => bar.classList.add('playing'));
                        isPlaying = true;
                    }).catch(err => console.log('Audio playback error: ', err));
                } else {
                    audio.pause();
                    playIcon.classList.remove('hidden');
                    pauseIcon.classList.add('hidden');
                    waveBars.forEach(bar => bar.classList.remove('playing'));
                    isPlaying = false;
                }
            }

            playBtn.addEventListener('click', () => togglePlay());

            // Track Time Update
            audio.addEventListener('timeupdate', () => {
                const percent = (audio.currentTime / audio.duration) * 100;
                progressFilled.style.width = `${percent}%`;
                
                // Formatted Time
                const curM = Math.floor(audio.currentTime / 60);
                const curS = Math.floor(audio.currentTime % 60).toString().padStart(2, '0');
                currentTimeEl.textContent = `${curM}:${curS}`;
            });

            audio.addEventListener('loadedmetadata', () => {
                const durM = Math.floor(audio.duration / 60);
                const durS = Math.floor(audio.duration % 60).toString().padStart(2, '0');
                totalTimeEl.textContent = `${durM}:${durS}`;
            });

            // Progress Click
            progressContainer.addEventListener('click', (e) => {
                const width = progressContainer.clientWidth;
                const clickX = e.offsetX;
                const duration = audio.duration;
                if (duration) {
                    audio.currentTime = (clickX / width) * duration;
                }
            });

            // Volume Control
            volumeContainer.addEventListener('click', (e) => {
                const width = volumeContainer.clientWidth;
                const clickX = e.offsetX;
                let volume = clickX / width;
                if (volume < 0) volume = 0;
                if (volume > 1) volume = 1;
                audio.volume = volume;
                volumeFilled.style.width = `${volume * 100}%`;
            });

            // Queue navigation
            const nextBtn = document.getElementById('next-btn');
            const prevBtn = document.getElementById('prev-btn');

            nextBtn.addEventListener('click', () => {
                if (currentQueue.length > 0 && currentIndex < currentQueue.length - 1) {
                    currentIndex++;
                    const track = currentQueue[currentIndex];
                    triggerPlayTrack(track);
                }
            });

            prevBtn.addEventListener('click', () => {
                if (currentQueue.length > 0 && currentIndex > 0) {
                    currentIndex--;
                    const track = currentQueue[currentIndex];
                    triggerPlayTrack(track);
                }
            });

            function triggerPlayTrack(track: any) {
                window.dispatchEvent(new CustomEvent('play-track', {
                    detail: {
                        src: track.src,
                        title: track.title,
                        artist: track.artist,
                        artwork: track.artwork,
                        queue: currentQueue,
                        index: currentIndex
                    }
                }));
            }

            // Mute volume toggling
            let lastVolume = 0.8;
            muteBtn.addEventListener('click', () => {
                if (audio.volume > 0) {
                    lastVolume = audio.volume;
                    audio.volume = 0;
                    volumeFilled.style.width = '0%';
                } else {
                    audio.volume = lastVolume;
                    volumeFilled.style.width = `${lastVolume * 100}%`;
                }
            });

            // CURSOR PROXIMITY GLOW EFFECT FOR CARDS
            document.addEventListener('mousemove', (e) => {
                const cards = document.querySelectorAll('.premium-card');
                cards.forEach((card: any) => {
                    const rect = card.getBoundingClientRect();
                    const x = e.clientX - rect.left;
                    const y = e.clientY - rect.top;
                    card.style.setProperty('--mouse-x', `${x}px`);
                    card.style.setProperty('--mouse-y', `${y}px`);
                });
            });
        </script>
	</body>
</html>

