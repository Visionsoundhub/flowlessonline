---
import '../styles/global.css';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';

interface Props {
	title: string;
}

const { title } = Astro.props;

// Fetch appearance settings (if they exist)
const reader = createReader(process.cwd(), keystaticConfig);
const appearance = await reader.singletons.appearance.read();
const accentColor = appearance?.accent || '#00FFD1';
---

<!doctype html>
<html lang="el">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Flowless Music - Official Website" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | Flowless Music</title>
        <style define:vars={{ accentColor }}>
            :root {
                --accent-color: var(--accentColor);
            }
        </style>
	</head>
	<body>
        <header>
            <div class="container">
                <a href="/" class="logo">Flowless</a>
                <nav class="desktop-nav">
                    <ul>
                        <li><a href="/">Home</a></li>
                        <li><a href="/roster">Roster</a></li>
                        <li><a href="/soundcheck">Soundcheck</a></li>
                        <li><a href="/merch">Merch</a></li>
                    </ul>
                </nav>
            </div>
        </header>
		<main>
			<slot />
		</main>
        
        <footer style="text-align: center; padding: 4rem 0; border-top: 1px solid rgba(255, 255, 255, 0.05); margin-top: 5rem; background: #080809; position: relative; z-index: 10;">
            <div class="container">
                <p style="margin-bottom: 0.5rem;">&copy; {new Date().getFullYear()} Flowless Music. All rights reserved.</p>
                <p style="font-size: 0.85rem; color: #555;">Curated beats, soundscapes and music releases.</p>
            </div>
        </footer>

        <script>
            // CURSOR PROXIMITY GLOW EFFECT FOR CARDS
            document.addEventListener('mousemove', (e) => {
                const cards = document.querySelectorAll('.premium-card');
                cards.forEach((card: any) => {
                    const rect = card.getBoundingClientRect();
                    const x = e.clientX - rect.left;
                    const y = e.clientY - rect.top;
                    card.style.setProperty('--mouse-x', `${x}px`);
                    card.style.setProperty('--mouse-y', `${y}px`);
                });
            });
        </script>
	</body>
</html>


